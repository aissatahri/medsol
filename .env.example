# Configuration de production de MedSol — copier en « .env » (jamais versionné) et remplir.
# Secrets : openssl rand -base64 32   (une valeur différente pour chacun)

# Nom de domaine public (le certificat HTTPS est obtenu automatiquement ; le DNS doit pointer vers le serveur)
MEDSOL_DOMAINE=app.exemple.com

# Base de données
MEDSOL_DB_PASSWORD=

# Clé de chiffrement des secrets en base (double authentification). À GARDER AUSSI HORS DU SERVEUR :
# perdue, les doubles authentifications devront toutes être réactivées.
MEDSOL_ENCRYPTION_KEY=

# Sauvegardes chiffrées. Phrase à GARDER HORS DU SERVEUR : sans elle, les sauvegardes sont illisibles.
MEDSOL_BACKUP_PASSPHRASE=
MEDSOL_BACKUP_HOUR=02
MEDSOL_BACKUP_DAYS=30
MEDSOL_BACKUP_TEST=true
# Dossier des sauvegardes sur le serveur (idéalement un autre disque)
MEDSOL_BACKUP_DIR=./sauvegardes
# Copie hors du serveur après chaque sauvegarde : lancée pour le fichier puis son empreinte, chemin dans $FICHIER.
# Entre apostrophes simples (sinon Docker Compose remplace $FICHIER). Exemple avec rclone (inclus dans l'image) :
# MEDSOL_BACKUP_COPY_CMD='rclone copy --config /sauvegardes/rclone.conf "$FICHIER" distant:medsol-sauvegardes/'
MEDSOL_BACKUP_COPY_CMD=
MEDSOL_TZ=Africa/Casablanca

# Administrateurs de la plateforme MedSol (e-mails séparés par des virgules)
MEDSOL_PLATFORM_ADMINS=

# Double authentification obligatoire pour les médecins
MEDSOL_REQUIRE_2FA_DOCTORS=false

# E-mails (mot de passe oublié, invitations) : serveur SMTP du fournisseur (Brevo, Mailjet, Amazon SES, OVH...)
MEDSOL_MAIL_HOST=
MEDSOL_MAIL_PORT=587
MEDSOL_MAIL_USER=
MEDSOL_MAIL_PASSWORD=
MEDSOL_MAIL_FROM=no-reply@exemple.com

# Paiement de l'abonnement
MEDSOL_STRIPE_SECRET_KEY=
MEDSOL_STRIPE_WEBHOOK_SECRET=
MEDSOL_BILLING_INSTRUCTIONS=
